#!/usr/bin/env python3
"""Thin wrapper for the package CLI.

The real implementation lives in pokemon_battle_assistant.pba_cli so editable
installs and the repository-local ./pba command use the same code path.

When a project-local .venv exists, this wrapper prefers .venv/bin/python. This
keeps the README alias (`pba=.../pokemon-battle-assistant/pba`) from accidentally
using a system/Conda Python that does not have poke-env installed.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
LOCAL_PYTHON = PROJECT_ROOT / ".venv" / "bin" / "python"

if os.environ.get("PBA_NO_LOCAL_VENV") != "1" and LOCAL_PYTHON.exists():
    # Do not compare resolve() here: venv/bin/python often resolves to the base
    # interpreter path, which would make a system/Conda Python look identical to
    # the local venv Python on macOS.
    current = Path(sys.executable).absolute()
    target = LOCAL_PYTHON.absolute()
    if current != target:
        os.execv(str(target), [str(target), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(PROJECT_ROOT / "src"))

from pokemon_battle_assistant.pba_cli import main

if __name__ == "__main__":
    main()
